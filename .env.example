# Settings of the `depthwatch` CLI. Copy to `.env` (git-ignored); variables already set in the
# environment win over this file, and flags win over both. Every variable `depthwatch start`
# reads is listed here; docs/DEPLOY.md has the settings for a server.

# Base mainnet JSON-RPC endpoint. Any standard endpoint works; a paid one is recommended
# for full-coverage snapshots (tick-bitmap walks are multicall heavy). On a server with
# Alchemy's free tier: https://base-mainnet.g.alchemy.com/v2/<key> (the key stays in the URL,
# which is never logged). Start with `depthwatch discover --seed` (the reference-token pools,
# no eth_getLogs): a first plain `discover` scans the factories' logs from their deployment
# blocks, about 97,000 eth_getLogs at 2000-block chunks as of late October 2026 (about 1,700 more
# a day since Base's 200 ms blocks), hours on this public endpoint.
DEPTHWATCH_RPC_URL=https://mainnet.base.org

# Endpoint for eth_getLogs only (discover, volume, positions); defaults to DEPTHWATCH_RPC_URL.
# Use it when the main endpoint is a plan that caps log ranges (Alchemy's free tier: 10 blocks)
# and another endpoint accepts wide ranges. Both URLs are http(s). URLs may carry API keys: they
# are never logged, and error messages keep only a URL's origin.
# DEPTHWATCH_LOGS_RPC_URL=https://mainnet.base.org

# Blocks per eth_getLogs request (default 2000, what Base's public RPC accepts; 400 s of chain
# since Base's 200 ms blocks). Keep the default here: on a plan that caps log ranges, set the cap
# per command, for short scans only, e.g. `DEPTHWATCH_LOG_CHUNK=10 depthwatch volume --hours 1`
# (Alchemy free; 24 h is 432,000 blocks, about 43,200 requests per event source). Set globally,
# a plain `discover` would scan from the factories' deployment blocks in 10-block requests, about
# 5 M per factory; discover with `depthwatch discover --seed` instead, which reads factory views,
# not logs.
# DEPTHWATCH_LOG_CHUNK=2000

# SQLite database file (default ./depthwatch.db). Created on first run. On a server, put it on a
# disk that survives restarts. Leave unset for the Docker image, which keeps it at
# /data/depthwatch.db: this file is passed to the container as it is (--env-file), where a
# relative path would point inside the image.
# DEPTHWATCH_DB=./depthwatch.db

# API/web server port (serve, start, demo; default 8787). Leave unset on a platform that sets
# PORT: DEPTHWATCH_PORT wins over PORT, so a value here would hide the platform's port.
# DEPTHWATCH_PORT=8787
# PORT=10000

# Interface the server binds (default 0.0.0.0: every interface).
# DEPTHWATCH_HOST=0.0.0.0

# Number of pools (ranked by TVL) to take full depth snapshots of. The main lever of the snapshot
# cost on a metered endpoint.
DEPTHWATCH_TOP_POOLS=200

# Days of snapshots and hourly volume `depthwatch prune` keeps (default 30; snapshots keep at
# least 8). `run` and `start` prune once a day; scorecard samples keep 35 days, alerts 90.
# DEPTHWATCH_KEEP_DAYS=30

# Token addresses seeded besides the reference tokens, comma-separated: `discover --seed`,
# `run --seed` and `start` also ask each DEX for their pairs (e.g. a project's own token).
# DEPTHWATCH_SEED_TOKENS=

# debug, info, warn, error or silent (default info). Logs go to stderr.
# DEPTHWATCH_LOG_LEVEL=info

# Public base URL of this deployment, used for the scorecard links `mm register` prints and the
# `scorecardUrl` of webhook alerts. Defaults to http://<host>:<port> of `serve`.
# DEPTHWATCH_PUBLIC_URL=https://depthwatch.example

# Bearer token that `POST /api/mm` and `DELETE /api/mm/:id` require (serve, start and demo).
# Environment only, no flag. Unset, those routes answer 403 and mandates are registered with
# `mm register`. At least 32 characters: generate one with `openssl rand -hex 32`. Send it only
# over HTTPS, through a reverse proxy that terminates TLS (docs/DEPLOY.md).
# DEPTHWATCH_ADMIN_TOKEN=

# The schedule of `depthwatch start` (docs/ARCHITECTURE.md "Running as a service"). Durations
# take units: 90s, 30m, 6h, 1d; a plain number is seconds. The defaults fit Alchemy's free tier
# with eth_getLogs on DEPTHWATCH_LOGS_RPC_URL and about 200 tracked pools.
# Time between passes; each pass snapshots and scores (default 30m, at least 1m).
# DEPTHWATCH_SNAPSHOT_INTERVAL=30m
# Time between volume runs (default 1h).
# DEPTHWATCH_VOLUME_INTERVAL=1h
# Time between LP position runs, or off (default 6h).
# DEPTHWATCH_POSITIONS_INTERVAL=6h
# Longest a positions run starts new work (default 10m).
# DEPTHWATCH_POSITIONS_BUDGET=10m
# Longest factory-log discovery runs per pass, or off to rely on the seed alone (default 15m).
# DEPTHWATCH_DISCOVER_BUDGET=15m
# How long SIGTERM waits for the step in flight before abandoning it (default 8s; environment
# only).
# DEPTHWATCH_SHUTDOWN_GRACE=8s

# The trade switch `depthwatch export` writes into the static bundle and into flags.json next to it
# (docs/DEPLOY.md, "Trade switch"): off, or a comma-separated list of trade venues such as
# uniswap-v3. Unset means off; an unknown or held venue writes the switch off and fails the export
# (exit code 3). Read by export alone; environment only.
# DEPTHWATCH_TRADE=off
